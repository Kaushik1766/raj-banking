<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<!--
    Test-scope override of src/main/resources/hibernate.cfg.xml. Maven puts
    target/test-classes ahead of target/classes on the test classpath, so
    HibernateUtil transparently picks up this in-memory H2 configuration
    instead of the production MySQL one whenever tests run.
-->
<hibernate-configuration>
    <session-factory>
        <property name="hibernate.connection.driver_class">org.h2.Driver</property>
        <property name="hibernate.connection.url">jdbc:h2:mem:loanapp;DB_CLOSE_DELAY=-1</property>
        <property name="hibernate.connection.username">sa</property>
        <property name="hibernate.connection.password"></property>

        <property name="hibernate.dialect">org.hibernate.dialect.H2Dialect</property>
        <property name="hibernate.connection.pool_size">5</property>
        <property name="hibernate.current_session_context_class">thread</property>

        <property name="hibernate.show_sql">false</property>
        <property name="hibernate.hbm2ddl.auto">create-drop</property>

        <mapping class="com.rajbank.loanapp.model.User"/>
        <mapping class="com.rajbank.loanapp.model.Customer"/>
        <mapping class="com.rajbank.loanapp.model.LoanApplication"/>
        <mapping class="com.rajbank.loanapp.model.RememberMeToken"/>
        <mapping class="com.rajbank.loanapp.model.SequenceCounter"/>
    </session-factory>
</hibernate-configuration>
